# Tool: *, Method: Port Scanning
# Why is this so hard? What we call "Port Scanning" happens constantly throughout the network. The act of sending a Syn packet, or any other "scanning" packet, is not unique 
# to port scanning. This means that being too aggressive in our search will lead to a ton of false positives. On top of that, tools such as Nmap have built-in IDS/IPS
# evasion modes. Nmap's -T1 mode, nicknamed paranoid-mode, will wait five minutes between probes. This is essentially impossible to detect feasibly with Suricata. 
# So why did we choose 10 and 5 for our threshold? Nmap's -T2 waits 0.4 seconds between probes, Suricata will still catch this.
alert tcp any any -> any ![80, 443] (msg:"SYN/Connect() Scan Detected! (Default: count=10, time limit=5)"; sid:150007; rev:1; tcp.flags:S; threshold: type both, track by_src, count 10, seconds 5;)
alert tcp any any -> any ![80, 443] (msg:"FIN Scan Detected! (Default: count=10, time limit=5)"; sid:150008; rev:1; tcp.flags:F; threshold: type both, track by_src, count 10, seconds 5;)
alert tcp any any -> any ![80, 443] (msg:"Xmas Scan Detected! (Default: count=10, time limit=5)"; sid:150009; rev:1; tcp.flags:FPU; threshold: type both, track by_src, count 10, seconds 5;)
#alert tcp any any -> any ![80, 443] (msg:"ACK/Window Scan Detected! (Default: count=10, time limit=5)"; sid:150010; rev:1; tcp.flags:A; flow: stateless; threshold: type both, track by_src, count 10, seconds 5;)
alert tcp any any -> any ![80, 443] (msg:"Maimon Scan Detected! (Default: count=10, time limit=5)"; sid:150011; rev:1; tcp.flags:FA; threshold: type both, track by_src, count 10, seconds 5;)
